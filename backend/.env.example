# ScoutMind 本地配置示例。复制为 backend/.env 后填写；.env 已被 .gitignore 忽略，禁止提交真实 Key。

# 数据库与数据目录（默认即可）
# SCOUTMIND_DATABASE_URL=sqlite:///./data/scoutmind.db
# SCOUTMIND_DATA_DIR=./data

# 模型 Provider（OpenAI 兼容）
# 未启用或没有 Key 时，Agent 走本地确定性规则，并在报告中标注 mode=deterministic。
SCOUTMIND_AGENT_LLM_ENABLED=false
SCOUTMIND_AGENT_LLM_API_KEY=
# DeepSeek（默认）：https://api.deepseek.com + /v1/chat/completions
SCOUTMIND_AGENT_LLM_BASE_URL=https://api.deepseek.com
SCOUTMIND_AGENT_LLM_CHAT_PATH=/v1/chat/completions
SCOUTMIND_AGENT_LLM_MODEL=deepseek-chat
SCOUTMIND_AGENT_LLM_TIMEOUT_SECONDS=60

# 智谱 GLM-4.7-Flash（OpenAI 兼容端点，注意没有 /v1）
# SCOUTMIND_AGENT_LLM_ENABLED=true
# SCOUTMIND_AGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# SCOUTMIND_AGENT_LLM_CHAT_PATH=/chat/completions
# SCOUTMIND_AGENT_LLM_MODEL=glm-4.7-flash
# SCOUTMIND_AGENT_LLM_API_KEY=your-key-here

# Runtime 硬限制
# SCOUTMIND_AGENT_MAX_STEPS=8
# SCOUTMIND_AGENT_MAX_TOOL_CALLS=5
# SCOUTMIND_AGENT_TASK_TIMEOUT_SECONDS=120
# SCOUTMIND_AGENT_MODEL_TIMEOUT_SECONDS=60
# SCOUTMIND_AGENT_APPROVAL_TTL_SECONDS=600
