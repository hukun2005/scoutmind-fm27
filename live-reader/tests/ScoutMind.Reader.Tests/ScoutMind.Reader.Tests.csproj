<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-contained console test runner: no xunit, no NuGet packages, offline restore.
       The same executable doubles as the fake scanner the adapter tests spawn. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ScoutMind.Reader.Tests</RootNamespace>
    <AssemblyName>ScoutMind.Reader.Tests</AssemblyName>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ScoutMind.Reader\ScoutMind.Reader.csproj" />
  </ItemGroup>

</Project>
