<Project Sdk="Microsoft.NET.Sdk">

  <!-- 与 ScoutMind.Reader.Tests 相同的策略：自带控制台测试运行器，不依赖 xunit / NuGet，离线可跑。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ScoutMind.FMReader.Tests</RootNamespace>
    <AssemblyName>ScoutMind.FMReader.Tests</AssemblyName>
    <IsTestProject>false</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ScoutMind.FMReader\ScoutMind.FMReader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 真实导出样本（已在 backend 侧脱敏登记），直接复用，避免两套数据真相。 -->
    <Content Include="..\..\..\backend\tests\fixtures\fmsuperscout\real_sample_01.json"
             Link="fixtures\real_sample_01.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
