<Project>

  <!-- Shared build settings for the Windows live-reader stack.
       No NuGet packages are referenced anywhere in this tree: restore must work offline. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: public members are documented by policy, but missing docs stay non-blocking. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Offline builds must not contact a vulnerability feed. -->
    <NuGetAudit>false</NuGetAudit>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <!-- No workloads are used here; the workload SDK resolver only produces MSB4276 noise on hosts
         whose workload manifest folders are incomplete. -->
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <BuildInParallel>false</BuildInParallel>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB4276</MSBuildWarningsAsMessages>
  </PropertyGroup>

</Project>
