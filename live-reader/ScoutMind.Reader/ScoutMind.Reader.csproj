<Project Sdk="Microsoft.NET.Sdk">

  <!-- External, read-only FM27 scanner front-end. It never loads or writes the game process:
       it locates the install, gates on build/plugin versions, and shells out to a scanner. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ScoutMind.Reader</RootNamespace>
    <AssemblyName>ScoutMind.LiveReader</AssemblyName>
    <AssemblyTitle>ScoutMind Live Reader</AssemblyTitle>
    <Product>ScoutMind</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScoutMind.Contracts\ScoutMind.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Single source of truth for the compatibility list lives at the repo config/ folder. -->
    <Content Include="..\..\config\compatibility.json"
             Link="compatibility.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
