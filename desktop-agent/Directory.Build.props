<Project>

  <!-- Shared build settings for the Windows desktop agent. No NuGet packages are referenced:
       restore must work offline. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <NuGetAudit>false</NuGetAudit>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <!-- No workloads are used here; on hosts with incomplete workload manifest folders the
         resolver only emits MSB4276 noise. -->
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <BuildInParallel>false</BuildInParallel>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB4276</MSBuildWarningsAsMessages>
  </PropertyGroup>

</Project>
