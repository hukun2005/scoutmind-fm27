<Project Sdk="Microsoft.NET.Sdk">

  <!-- Orchestrates the reader: runs it, schedules scans, queues failed backend syncs.
       It never reads game memory itself and never invents scan results. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ScoutMind.Agent</RootNamespace>
    <AssemblyName>ScoutMind.Agent</AssemblyName>
    <AssemblyTitle>ScoutMind Desktop Agent</AssemblyTitle>
    <Product>ScoutMind</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\live-reader\ScoutMind.Contracts\ScoutMind.Contracts.csproj" />
    <ProjectReference Include="..\..\live-reader\ScoutMind.Reader\ScoutMind.Reader.csproj" />
  </ItemGroup>

</Project>
