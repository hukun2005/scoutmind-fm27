{
  "tool": "verify_backend_restart_recovery",
  "synthetic_identity": true,
  "real_fm27": false,
  "checks": [
    {
      "label": "baseline_import_succeeded",
      "ok": true,
      "expect": "201",
      "observed": {
        "status": 201
      }
    },
    {
      "label": "backend_killed_mid_import",
      "ok": true,
      "expect": "在 running 状态硬杀后端",
