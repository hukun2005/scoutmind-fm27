# ScoutMind backend configuration. Copy to backend/.env and adjust.

# 数据库：默认 SQLite，改用 PostgreSQL 时取消下一行注释
# SCOUTMIND_DATABASE_URL=postgresql+psycopg://scoutmind:scoutmind@127.0.0.1:5432/scoutmind
SCOUTMIND_DATABASE_URL=sqlite:///data/scoutmind.db

# 本地 API 令牌：设置后除 /api/v1/health 外都需要 X-ScoutMind-Token
# SCOUTMIND_API_TOKEN=change-me-to-a-random-string

# 只监听本机
SCOUTMIND_HOST=127.0.0.1
SCOUTMIND_PORT=8000

# 允许的前端来源（逗号分隔）
SCOUTMIND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 估值最小样本
SCOUTMIND_MIN_SIMILAR_SAMPLE=5

# 可选：LLM 规划器（当前版本未启用，保留配置位）
SCOUTMIND_AGENT_LLM_ENABLED=false
SCOUTMIND_AGENT_LLM_BASE_URL=https://api.deepseek.com
SCOUTMIND_AGENT_LLM_MODEL=deepseek-chat
# SCOUTMIND_AGENT_LLM_API_KEY=
